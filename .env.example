APP_NAME=AI Support Ticket Analytics
ENVIRONMENT=development

DATA_PATH=data/support_tickets.csv
DATABASE_PATH=data/support_tickets.db

LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

ANOMALY_RESOLUTION_THRESHOLD_HOURS=24
ANOMALY_RESPONSE_THRESHOLD_HOURS=4
LOW_RATING_THRESHOLD=2
STATISTICAL_Z_THRESHOLD=2
